# ============================================================
# EDGE OS — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# --- PUBLIC (browser-safe, embedded at build time) ----------
# Finnhub: real-time quotes, company news, insider transactions
# Free tier: 60 calls/min — https://finnhub.io
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage: technical indicators (RSI, MACD, SMA)
# Free tier: 25 calls/day — https://www.alphavantage.co
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI: market news headlines and sentiment
# Free tier: 100 calls/day — https://newsapi.org
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# Supabase project URL (safe to expose)
# https://supabase.com — create a project to get this
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Supabase anon/public key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- SERVER-ONLY (never expose to the browser) --------------
# OpenAI: AI analysis features (requires API routes or server components)
OPENAI_API_KEY=your_openai_key_here

# Supabase service role key (admin access — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vercel deployment token (CI/CD use only)
VERCEL_TOKEN=your_vercel_token_here
