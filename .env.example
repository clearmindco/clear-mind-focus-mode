# ============================================================
# EDGE OS — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# ─── CURRENTLY WIRED ────────────────────────────────────────
# Finnhub: live stock quotes fetched in EDGE Terminal on every page load.
# Free tier: 60 calls/min — https://finnhub.io
# Get key: finnhub.io → Sign up free → Dashboard → API Key
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_key_here

# ─── FUTURE / NOT YET WIRED ─────────────────────────────────
# These keys are defined in lib/data-providers.ts but not yet
# connected to any live UI feature. Add them when the feature is built.

# Alpha Vantage: technical indicators (RSI, MACD, SMA) — coming in Terminal overlays
# Free tier: 25 calls/day — https://www.alphavantage.co
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI: market news headlines — coming in Research Lab news feed
# Free dev tier: 100 calls/day — https://newsapi.org
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here
