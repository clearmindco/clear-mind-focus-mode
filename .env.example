# ============================================================
# EDGE OS — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# ─── SERVER-ONLY API KEYS ────────────────────────────────────
# These keys have NO NEXT_PUBLIC_ prefix.
# They are used only in server Route Handlers (app/api/*).
# They are NEVER sent to the browser or included in the JS bundle.
# Set in Netlify: Site Settings → Environment Variables → Add variable.

# Finnhub: real-time quotes, company news, insider transactions
# Used in: /api/quote, /api/news, /api/market-radar, /api/signal
# Free tier: 60 calls/min — https://finnhub.io
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage: technical indicators (RSI, MACD, SMA)
# Used in: /api/technical (coming soon)
# Free tier: 25 calls/day — https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI: market news headlines
# Used in: /api/news enhancement (coming soon)
# Free dev tier: 100 calls/day (localhost only) — https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI: AI Trade Coach analysis (planned)
# Used in: /api/ai-coach (planned — not yet in codebase)
# Pay-per-use — https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# ─── CLIENT-SAFE BOOLEAN FLAGS ───────────────────────────────
# Set to "true" ONLY when the corresponding server-side key above is configured.
# These tell the browser UI which features are active.
# They contain NO secret values — safe to expose.
# Set these in Netlify alongside the server keys, then redeploy.

NEXT_PUBLIC_FINNHUB_CONNECTED=false
NEXT_PUBLIC_NEWSAPI_CONNECTED=false
NEXT_PUBLIC_ALPHAVANTAGE_CONNECTED=false
